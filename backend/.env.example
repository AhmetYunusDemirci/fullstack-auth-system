# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# MONGODB CONNECTION
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mystore?retryWrites=true&w=majority

# JWT (JSON WEB TOKEN)
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=30d

# IYZICO PAYMENT GATEWAY (SANDBOX)
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_URI=https://sandbox-api.iyzipay.com
